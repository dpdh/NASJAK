{
  "expo": {
    "name": "NASUHA",
    "slug": "nasjak-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "nasjak",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F0FAFF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nasuha.nasjak",
      "infoPlist": {
        "NSCameraUsageDescription": "NASUHA App membutuhkan akses kamera untuk mengambil foto profil.",
        "NSPhotoLibraryUsageDescription": "NASUHA App membutuhkan akses galeri untuk memilih foto profil.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#F0FAFF"
      },
      "package": "com.nasuha.nasjak",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.RECORD_AUDIO",
        "android.permission.SCHEDULE_EXACT_ALARM"
      ]
    },
    "web": {
      "favicon": "./assets/images/icon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      "expo-splash-screen",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "color": "#00B4D8",
          "defaultChannel": "reminders"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Izinkan NASUHA menggunakan lokasi Anda untuk waktu shalat, arah kiblat, dan masjid terdekat."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "NASUHA App membutuhkan akses galeri untuk memilih foto profil.",
          "cameraPermission": "NASUHA App membutuhkan akses kamera untuk mengambil foto profil."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f6987a08-ba13-4375-83de-976b29c54af0"
      }
    }
  }
}
